# Copy to .env and fill in, or run:  bash scripts/create-secrets.sh --generate
# (--generate fills every empty value with a random secret or a sane local default
#  and never overwrites a value you already set.)
# .env is gitignored. scripts/create-secrets.sh turns it into Kubernetes Secrets.

# ---------- platform namespace ----------
# Postgres password. DATABASE_URL for the gateway is derived from it by create-secrets.sh.
POSTGRES_PASSWORD=
# Random string, >= 32 chars. Used to sign/derive session cookies.
SESSION_SECRET=
# 32 random bytes, base64-encoded. AES-256-GCM key for upstream credentials.
CREDENTIAL_ENC_KEY=
# First-boot admin for the dashboard (only used when the users table is empty).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Chat agent: API key of the OpenAI-compatible provider (default Groq, free key at
# console.groq.com). Leave empty to turn chat off, or for a local Ollama endpoint.
LLM_API_KEY=

# ---------- shared between platform and store ----------
# Bearer token the gateway uses to call woo-mcp. Written into both namespaces.
WOO_MCP_BEARER_TOKEN=

# ---------- store namespace ----------
MARIADB_ROOT_PASSWORD=
# Used as both MARIADB_PASSWORD (mariadb-secrets) and WORDPRESS_DB_PASSWORD (wordpress-secrets).
MARIADB_PASSWORD=
WP_ADMIN_USER=
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=
# Random string; expands into WordPress's 8 auth keys/salts (stable across pod restarts).
WORDPRESS_SALT=
# WC_CONSUMER_KEY / WC_CONSUMER_SECRET are NOT set here: the store-init Job creates them.

# ---------- upstreams namespace ----------
NOTES_MCP_BEARER_TOKEN=
SLOW_MCP_BEARER_TOKEN=

# ---------- provisioner namespace (multi-store bonus) ----------
# Shared secret for gateway -> store provisioner calls. Written into both namespaces.
PROVISIONER_TOKEN=

# ---------- production only: private image registry (optional) ----------
# Set all three to create a "registry-pull" image pull secret in every namespace, then set
# global.image.pullSecrets: [registry-pull] in values-prod.yaml. Use a read-only token
# (e.g. a GitHub token with only read:packages for ghcr.io). Leave empty for Kind or for
# public images.
REGISTRY_SERVER=
REGISTRY_USERNAME=
REGISTRY_TOKEN=
