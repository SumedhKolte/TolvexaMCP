{
  "name": "team-mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Team MCP Gateway with WooCommerce Hosting",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "helm:check": "bash scripts/helm-check.sh",
    "up": "bash scripts/up-local.sh",
    "down": "bash scripts/teardown-local.sh",
    "e2e": "bash scripts/e2e-dod.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "yaml": "2.9.0"
  }
}
