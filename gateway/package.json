{
  "name": "@tmg/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Team MCP gateway: auth, registry, dispatch, /mcp, /api, chat",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "openai": "^7.32.0",
    "pg": "^8.23.1",
    "prom-client": "15.1.3",
    "undici": "^8.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
